# Скопируйте в .env (локально) или задайте в настройках хостинга (Vercel → Settings → Environment Variables).
# Файл .env в git не попадает (.gitignore). Сам ключ сюда не вписывайте.

# Обязательно: секретный ключ ElevenLabs (нужно право Text to Speech)
ELEVENLABS_API_KEY=

# Модель и звучание (значения по умолчанию = проверенные настройки: Eleven v4, Stability Natural, язык Auto)
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# on = эмоции режимов через аудиотеги ([happily], [softly]…), off = текст без тегов
TTS_AUDIO_TAGS=on
# off = Language Override «Auto»; on = передавать язык сайта (ru/kk/en) в language_code
TTS_SEND_LANGUAGE=off

# Ограничение расходов (кредиты ≈ символы; 0 = без ограничения)
TTS_MAX_CHARS=2500            # символов в одном запросе
TTS_MAX_TEXT_CHARS=6000       # символов во всей записи дня (длиннее — читает голос браузера)
TTS_IP_PER_MINUTE=10          # запросов в минуту с одного IP
TTS_IP_DAILY_CREDITS=8000     # кредитов в сутки с одного IP
TTS_DAILY_CREDITS=40000       # кредитов в сутки на весь сайт
TTS_CONCURRENCY=2             # одновременных запросов к ElevenLabs (на тарифе максимум 3)
TTS_CACHE_MB=32               # кэш готового аудио в памяти сервера

# Безопасность
# Разрешённые адреса сайта через запятую. Пусто = только тот же домен, что и сервер.
TTS_ALLOWED_ORIGINS=
# on, если сервер стоит за прокси (Render, Railway, nginx): тогда IP берётся из X-Forwarded-For. На Vercel включено само.
TRUST_PROXY=off

# Только для node server.js
PORT=8000
HOST=0.0.0.0
